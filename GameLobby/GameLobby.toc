# ============================================================
# 加载顺序见 docs/contracts.md §10。不依赖 BigFoot / 大脚（架构不变量 #5）。
# 尚未实现的模块为占位 stub（首行 local self = aura_env or {}），
# 另两个 agent 直接往 stub 里填实现，不必动本 .toc。
# ============================================================

# --- 引导（建立 _G.GameLobby + 事件总线，必须最先）---
Core\Bootstrap.lua

# --- 内嵌库（不依赖大脚）---
Libs\embeds.xml

# --- 通讯层 ---
Core\Comm.lua

# --- 核心模块 ---
Core\Roster.lua
Core\GameRegistry.lua
Core\Stats.lua
Core\Match.lua

# --- UI（theme 先，frame 次，widgets 子系统按依赖顺序，最后是 screens/popups）---
Core\UI\Theme.lua
Core\UI\Frame.lua

# Widgets 子系统：Primitives 必须先加载（其他 11 个组件都依赖它的 Solid/Ring/MetalBorder/SetFont/Text/Icons）；
# 其余组件互不依赖，按字母排序加载即可。每文件单一职责（SRP），新增组件加新文件不动既有（OCP）。
Core\UI\Widgets\Primitives.lua
Core\UI\Widgets\SectionLabel.lua
Core\UI\Widgets\Button.lua
Core\UI\Widgets\SmashButton.lua
Core\UI\Widgets\PlayerCard.lua
Core\UI\Widgets\LootCard.lua
