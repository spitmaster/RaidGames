Core\UI\Widgets\RankRow.lua
Core\UI\Widgets\StatCard.lua
Core\UI\Widgets\LogStrip.lua
Core\UI\Widgets\ScrollList.lua

Core\UI\Lobby.lua
Core\UI\Playing.lua
Core\UI\Results.lua
Core\UI\History.lua
Core\UI\About.lua
Core\UI\ImportPanel.lua
Core\UI\ExportPanel.lua
Core\UI\Popups.lua

# --- 导入/导出（Phase 2）---
Core\GameImport.lua

# --- 点对点游戏推送（P2P 分片传输，D17）---
Core\Push.lua

# --- 分享：内置整包 WA 串（左上「分享」按钮的数据源）---
Core\ShareBundle.lua

# --- 游戏（最后；RegisterGame 时核心已就绪）---
Games\SpeedClick.lua

# --- 引导器（最末，触发 GL:Init 队列 flush + 回收待注册游戏）---
Core\Init.lua
